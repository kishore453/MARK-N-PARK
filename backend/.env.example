# Server Port
PORT=8080

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/marknpark?retryWrites=true&w=majority

# JWT Authentication Config
JWT_SECRET=supersecretjwtkeythatisminimum256bitslongformarknparksecurityplatform2026!
JWT_EXPIRATION=86400000

# Razorpay Test Mode Credentials
RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpaySecretKeyHere

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Cloudinary Storage
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
